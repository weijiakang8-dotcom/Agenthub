# AgentHub 生产环境变量（复制为 .env.production，勿提交真实密钥）
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/agenthub
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
ADMIN_API_KEY=CHANGE_ME
CORS_ORIGINS=https://synplex.xyz
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
RUNTIME_MODE=legacy
REAL_EFFECT_MODE=false
SHADOW_MODE=false

# 邮件：生产环境走 Resend（SMTP_HOST 留空即可）；如用 SMTP 则填写主机与账号
RESEND_API_KEY=
RESEND_FROM=no-reply@synplex.xyz
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
