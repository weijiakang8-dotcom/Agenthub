# ===== AgentHub 环境变量示例 =====
# 使用：cp .env.example .env，然后按需修改

# 应用
APP_NAME=AgentHub
DEBUG=false
ENVIRONMENT=development

# JWT 登录密钥；生产环境必须改成至少 32 位随机字符串
JWT_SECRET_KEY=change-me-in-production

# 允许跨域访问的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL（asyncpg 异步驱动）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/agenthub

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-xxx

# 管理 API Key（用于 X-API-Key 请求头校验；留空则开发环境不校验）
ADMIN_API_KEY=

# DeepSeek（通过 OpenAI 兼容接口调用，api_key 复用 OPENAI_API_KEY）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 工具
TAVILY_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=agenthub@example.com

# Resend 邮件服务（验证码发送）
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# 告警通知
ALERT_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_SERVICE_NAME=agenthub-backend
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment=development
OTEL_SAMPLING_RATE=1.0
