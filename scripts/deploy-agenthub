#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly REPO=/home/ubuntu/agenthub
readonly COMPOSE_FILE="$REPO/docker/docker-compose.yml"
readonly LOCK_FILE=/run/lock/agenthub-production.lock
readonly BACKUP_DIR=/home/ubuntu/backups
readonly PUBLIC_HEALTH=https://synplex.xyz/health
readonly TARGET_SHA="${1:-}"
readonly COMPOSE=(docker compose -f "$COMPOSE_FILE")
readonly GIT=(
  git
  -c safe.directory="$REPO"
  -c http.version=HTTP/1.1
  -c http.lowSpeedLimit=1000
  -c http.lowSpeedTime=60
)

stage=validate
previous_sha=unknown
rollback_started=false
rollback_succeeded=false

log() { printf 'agenthub-deploy stage=%s %s\n' "$stage" "$*"; }
health_sha() {
  local url=$1
  curl -fsS --retry 5 --retry-delay 3 --max-time 15 "$url" \
    | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("status")=="ok" and d.get("database") is True and d.get("redis") is True and d.get("llm") is True; print(d.get("build_sha", ""))'
}
container_sha() { "${COMPOSE[@]}" exec -T backend printenv BUILD_SHA 2>/dev/null; }
verify_runtime() {
  local expected=$1 local_sha public_sha
  local_sha=$(health_sha http://127.0.0.1:8000/health)
  public_sha=$(health_sha "$PUBLIC_HEALTH")
  [[ "$(container_sha)" == "$expected" && "$local_sha" == "$expected" && "$public_sha" == "$expected" ]]
}
fetch_main() {
  local attempt
  for attempt in 1 2 3; do
    if "${GIT[@]}" fetch --quiet https://github.com/weijiakang8-dotcom/Agenthub.git main:refs/remotes/origin/main; then
      return 0
    fi
    log "fetch_retry=$attempt max_attempts=3"
    sleep $((attempt * 5))
  done
  return 1
}
rollback() {
  rollback_started=true
  stage=rollback
  log "started=true target_sha=$previous_sha"
  cd "$REPO"
  "${GIT[@]}" checkout --detach --force "$previous_sha"
  export BUILD_SHA="$previous_sha"
  "${COMPOSE[@]}" up -d --build --force-recreate backend worker frontend embedding
  "${COMPOSE[@]}" restart frontend
  sleep 10
  if verify_runtime "$previous_sha" && HEALTH_BASE_URL=http://127.0.0.1:8000 bash "$REPO/scripts/core_health_gate.sh"; then
    rollback_succeeded=true
    log "succeeded=true final_sha=$previous_sha"
    return 0
  fi
  log "succeeded=false final_sha=$(health_sha "$PUBLIC_HEALTH" 2>/dev/null || echo unknown)"
  return 1
}
on_error() {
  local rc=$?
  trap - ERR
  log "failed=true target_sha=$TARGET_SHA original_sha=$previous_sha"
  if [[ "$previous_sha" =~ ^[0-9a-f]{40}$ ]]; then rollback || true; fi
  log "rollback_started=$rollback_started rollback_succeeded=$rollback_succeeded final_sha=$(health_sha "$PUBLIC_HEALTH" 2>/dev/null || echo unknown)"
  exit "$rc"
}
trap on_error ERR

[[ "$TARGET_SHA" =~ ^[0-9a-f]{40}$ ]] || { log 'error=invalid_sha'; exit 2; }
exec 9>"$LOCK_FILE"
flock -n 9 || { log 'error=deployment_locked'; exit 3; }

cd "$REPO"
stage=fetch
fetch_main
[[ "$("${GIT[@]}" cat-file -t "$TARGET_SHA" 2>/dev/null)" == commit ]]
"${GIT[@]}" merge-base --is-ancestor "$TARGET_SHA" origin/main
previous_sha=$("${GIT[@]}" rev-parse HEAD)
log "target_sha=$TARGET_SHA original_sha=$previous_sha"

stage=backup
[[ -d "$BACKUP_DIR" ]] || install -d -m 750 -o ubuntu -g ubuntu "$BACKUP_DIR"
backup="$BACKUP_DIR/agenthub-predeploy-$(date +%Y%m%d-%H%M%S)-${previous_sha:0:12}.sql.gz"
docker exec agenthub-postgres pg_dump -U postgres -d agenthub --no-owner --no-privileges | gzip > "$backup"
test -s "$backup"
log "database_backup=$backup"

stage=migration-check
current_revision=$("${COMPOSE[@]}" exec -T backend alembic current 2>/dev/null | tail -1 | awk '{print $1}')
[[ "$current_revision" =~ ^[0-9]{4}$ ]]
# This deployment path deliberately never changes schema. A migration change requires a separate reviewed operation.
"${GIT[@]}" diff --quiet "$previous_sha" "$TARGET_SHA" -- backend/alembic backend/alembic.ini
log "database_revision=$current_revision schema_change=false"

stage=checkout
"${GIT[@]}" checkout --detach --force "$TARGET_SHA"
export BUILD_SHA="$TARGET_SHA"
export COMPOSE_PARALLEL_LIMIT=1

stage=build
"${COMPOSE[@]}" build backend worker frontend

stage=activate
"${COMPOSE[@]}" up -d --force-recreate backend worker frontend embedding
"${COMPOSE[@]}" restart frontend
sleep 10

stage=verify-sha
verify_runtime "$TARGET_SHA"

stage=health-gate
HEALTH_BASE_URL=http://127.0.0.1:8000 bash "$REPO/scripts/core_health_gate.sh"

stage=complete
log "succeeded=true target_sha=$TARGET_SHA original_sha=$previous_sha rollback_started=false final_sha=$TARGET_SHA"
